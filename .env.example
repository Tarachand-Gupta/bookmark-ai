# Copy to .env (server reads apps/server/.env or process env).
# In production these are set per-service: server vars on Render, web vars on
# Vercel. Never commit real values — .env and apps/web/.env.local are ignored.

# ── Shared / server (Render) ────────────────────────────────────────────────

# Gemini API key — powers AI categorization + embeddings (semantic search) and
# the web /api/chat agent. Get one at https://aistudio.google.com/apikey
# Optional: without it the server falls back to heuristic categorization and
# full-text-only search. Set on BOTH Render (server) and Vercel (web /api/chat).
GEMINI_API_KEY=

# Server port. Render injects its own $PORT; leave unset there.
PORT=4545

# Database (libSQL / Turso). Local file default below; for Turso cloud use a
# libsql://… URL plus the auth token. Manage with the `turso` CLI.
DATABASE_URL=file:./data/bookmarks.db
# Required for libsql:// (Turso) URLs; unused for local file: DBs.
DATABASE_AUTH_TOKEN=

# ── Web app (Vercel) ────────────────────────────────────────────────────────

# Web app -> API base. Local default below; in prod set to the Render URL,
# e.g. https://bookmark-ai-server.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4545

# Clerk auth keys live in apps/web/.env.local (created by `clerk init`, git
# ignored). Copy the same two into Vercel's env for the web deployment:
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
#   CLERK_SECRET_KEY=sk_...

# ── Multi-tenancy (per-user Turso DBs) ──────────────────────────────────────
# All read in apps/web/lib/server/context.ts + api-context.ts. UNSET = today's
# single-shared-DB behavior. The Clerk webhook route provisions/deprovisions
# tenants regardless of the flag (so tenants can be pre-provisioned first).

# Master switch. "1" turns ON per-user tenant routing (each Clerk user reads/
# writes their own Turso DB). Anything else / unset = single shared DB.
MULTI_TENANT=

# Master / control-plane DB (the tenant directory + per-day usage counters).
# Required when MULTI_TENANT=1 OR when webhook provisioning runs. A libsql://…
# Turso URL + its auth token (or file:… for local).
MASTER_DATABASE_URL=
MASTER_DATABASE_AUTH_TOKEN=

# Turso Platform API — used to create/delete each tenant's DB during
# provisioning. Token from `turso auth api-tokens mint`. TURSO_GROUP defaults
# to "default".
TURSO_API_TOKEN=
TURSO_ORG=
TURSO_GROUP=default

# Tenant platform selector. Unset / "turso" (default) → provision each user's DB
# as a real Turso DB via the Platform API above (prod). "local" → provision each
# user's DB as a sqlite FILE under TENANT_DB_DIR — dev only (ignored when
# NODE_ENV=production), so MULTI_TENANT=1 runs fully offline with no Turso creds.
# Local dev recipe (in apps/web/.env.local): MULTI_TENANT=1 +
# MASTER_DATABASE_URL=file:../../data/master-dev.db + TENANT_PLATFORM=local.
TENANT_PLATFORM=
TENANT_DB_DIR=../../data/tenants

# Clerk webhook signing secret (svix). Set on the endpoint in the Clerk
# dashboard (Webhooks → your endpoint → Signing Secret, starts "whsec_"). The
# /api/webhooks/clerk route verifies every request against this.
CLERK_WEBHOOK_SECRET=

# Per-user daily quotas (enforced only when MULTI_TENANT=1). Defaults shown.
QUOTA_SAVES_PER_DAY=200
QUOTA_SESSIONS_PER_DAY=50
QUOTA_CHATS_PER_DAY=100

# 32-byte base64 secret for AES-256-GCM encryption of stored AI provider API keys
# (user_settings.ai_api_key). Generate: openssl rand -base64 32. Set in root .env
# AND Vercel prod+preview. Stored format: "enc:v1:<iv-b64>:<ct+tag-b64>"; values
# without the enc: prefix are treated as legacy plaintext and re-encrypted on the
# next write. A missing/wrong secret degrades to "no key configured" (never crashes).
AI_KEY_ENCRYPTION_SECRET=

# ── Free-tier AI metering + admin ───────────────────────────────────────────
# Chat requests that run on the SERVER's fallback GEMINI_API_KEY (users with no
# own provider key) are metered against a GLOBAL weekly token budget
# (input+output, tool calls included), reset every Monday 00:00 UTC. The limit
# itself is NOT an env var — it lives in the master control-plane DB
# (platform_config key "free_ai_weekly_token_limit"), is admin-adjustable via
# PATCH /api/admin/ai-limit, and defaults to 1,000,000 tokens/week when unset or
# when no master DB is configured. Users with their OWN key are never metered.
#
# Admin allowlist for GET/PATCH /api/admin/ai-limit (CSV of Clerk user ids).
# Unset → defaults to the known owner id (user_3GIhPt5Na3tYRP3XaPPU3PpI55e).
ADMIN_USER_IDS=
