# Copy to .env (server reads apps/server/.env or process env)

# Gemini API key — powers AI categorization + embeddings (semantic search).
# Get one at https://aistudio.google.com/apikey
# Optional: without it, the server falls back to heuristic categorization
# and full-text-only search.
GEMINI_API_KEY=

# Server
PORT=4000

# Database (libSQL / Turso). File-based for now; swap for a turso:// URL later.
DATABASE_URL=file:./data/bookmarks.db

# Web app -> API base
NEXT_PUBLIC_API_URL=http://localhost:4000
