# Vercel uploads from the repo root (monorepo) but doesn't apply nested
# .gitignore files, so exclude build artifacts / caches here. Only build
# outputs are listed — all source and package.json files stay, so the pnpm
# workspace graph is intact and the web app + its deps still build.

# JS/TS build outputs and caches (Vercel builds fresh on its servers)
**/.next
**/.turbo
**/dist
**/.vercel

# Desktop (Zig) — irrelevant to the web build, and huge
apps/desktop/.native
**/.zig-cache
**/zig-out

# Extension build outputs
apps/extension/.output
apps/extension/.wxt

# Mobile — generated native projects (expo prebuild) + caches; never part
# of the web build, and tens of thousands of files (Pods, gradle output)
apps/mobile/ios
apps/mobile/android
apps/mobile/.expo

# Local DB files / cruft
data/
**/*.db
**/.DS_Store

# Env files must NEVER ride along in the upload: secrets stay local, and
# next.config.ts would inline NEXT_PUBLIC_* values from the root .env into
# the client bundle at build time (deployed env comes from Vercel env vars).
.env
**/.env
**/.env.*

# Untracked local tooling / caches — not part of the build, and big.
# .pnpm-store is the local pnpm content-addressable store (100s of MB);
# Vercel runs its own install. .agents/.claude/skills-lock are skill installs.
**/node_modules
.pnpm-store
.agents
.claude
skills-lock.json
