{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        ".output/**",
        "zig-out/**",
        ".next-supabase-qa/**",
        "!.next-supabase-qa/cache/**",
        "dist-supabase-qa/**",
        ".output-supabase-qa/**"
      ],
      "env": [
        "GEMINI_API_KEY",
        "OPENROUTER_API_KEY",
        "OPENROUTER_BASE_URL",
        "CLERK_SECRET_KEY",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_LIVE_API_URL",
        "CLERK_ALLOWED_USER_IDS",
        "MACOS_AUTH_APP_ORIGIN",
        "CRON_SECRET",
        "DATABASE_URL",
        "DATABASE_AUTH_TOKEN",
        "MULTI_TENANT",
        "MASTER_DATABASE_URL",
        "MASTER_DATABASE_AUTH_TOKEN",
        "TURSO_API_TOKEN",
        "TURSO_ORG",
        "TURSO_GROUP",
        "AI_KEY_ENCRYPTION_SECRET",
        "ADMIN_USER_IDS",
        "DEVICE_TOKEN_SECRET",
        "LIVE_ENCRYPTION_SECRET",
        "LANGFUSE_PUBLIC_KEY",
        "LANGFUSE_SECRET_KEY",
        "LANGFUSE_BASE_URL",
        "LANGFUSE_TRACING_ENVIRONMENT",
        "NEW_RELIC_LICENSE_KEY",
        "NEW_RELIC_REGION",
        "NEW_RELIC_LOG_LEVEL",
        "VERCEL_ENV",
        "POSTHOG_PROJECT_TOKEN",
        "POSTHOG_ENABLED",
        "POSTHOG_ALLOW_NON_PRODUCTION",
        "POSTHOG_MONTHLY_EVENT_LIMIT",
        "POSTHOG_SEARCH_SAMPLE_RATE",
        "POSTHOG_BILLING_CYCLE_START_DAY",
        "BOOKMARK_BUILD_VARIANT",
        "AUTH_PROVIDER",
        "NEXT_PUBLIC_AUTH_PROVIDER",
        "SUPABASE_*",
        "NEXT_PUBLIC_SUPABASE_*",
        "WXT_SUPABASE_*",
        "WXT_AUTH_PROVIDER",
        "WXT_BUILD_VARIANT",
        "EXPO_PUBLIC_SUPABASE_*",
        "EXPO_PUBLIC_AUTH_*",
        "EXPO_PUBLIC_BUILD_VARIANT",
        "MASTER_CREDENTIAL_ENCRYPTION_KEY",
        "TENANT_PLATFORM",
        "TENANT_DB_PREFIX",
        "TENANT_DB_DIR"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    }
  }
}
