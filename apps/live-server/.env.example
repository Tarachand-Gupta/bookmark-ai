# @bookmark-ai/live-server — copy to .env (gitignored) and fill in.

# Port the server listens on inside the container (Caddy fronts it).
PORT=8080

# Redis connection. In compose this is the service name; locally, your own Redis.
REDIS_URL=redis://redis:6379

# ── Clerk (offline JWT verification) ────────────────────────────────────────
# EITHER the secret key (fetches JWKS once, then networkless)…
CLERK_SECRET_KEY=sk_live_xxx
# …OR, for a fully egress-free VM, a pinned PEM public key + issuer (leave the
# secret unset if you use these):
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# CLERK_ISSUER=https://clerk.bookmark-ai.cloud

# Same allowlist the web app uses (Tara's id). CSV. Empty = allow any signed-in user.
CLERK_ALLOWED_USER_IDS=user_3GIhPt5Na3tYRP3XaPPU3PpI55e

# Mirror of apps/web/lib/authorized-parties.ts — the token `azp` allowlist. CSV.
# Absent azp (native mobile) always passes; a wrong azp is rejected.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000,https://bookmark-ai.cloud,https://www.bookmark-ai.cloud,https://bookmark-ai-theta.vercel.app,chrome-extension://ffhbgpgebpmofjkehpjcemepbgcmoelp

# CORS allowlist (browser origins that may call this server). CSV. Empty = reflect
# any origin — DEV ONLY; in production (NODE_ENV=production) this MUST be set or
# the server fails to start (it refuses to reflect any origin).
LIVE_ALLOWED_ORIGINS=https://bookmark-ai.cloud,https://www.bookmark-ai.cloud,http://localhost:3000,http://127.0.0.1:3000,chrome-extension://ffhbgpgebpmofjkehpjcemepbgcmoelp

# Device tokens (Safari extension header-auth). The same HMAC-SHA256 secret the
# web app mints `bkd_…` device tokens with — this server verifies them offline.
# 64-char hex (openssl rand -hex 32). Optional: unset = decline device tokens
# (the Clerk path stays primary). CI upserts this into the VM .env from the GH
# secret LIVE_DEVICE_TOKEN_SECRET on every deploy.
DEVICE_TOKEN_SECRET=

# At-rest encryption of live-tab `windowsJson` in Redis (AES-256-GCM, `enc:v1:`
# envelope — see src/crypto.ts). Base64 32-byte key: openssl rand -base64 32.
# Every envelope is additionally bound to its owner via GCM AAD (`userId:deviceId`),
# so a ciphertext copied into another device's/user's hash fails the auth tag.
#
#   UNSET/EMPTY = tabs stored plaintext with a one-time warn (dev ergonomics).
#   SET BUT INVALID (not base64, or not exactly 32 decoded bytes) = the server
#     REFUSES TO BOOT. A configured key must never silently degrade to plaintext,
#     so this is a hard, loud failure rather than a warn line — see config.ts.
#     A 64-char hex key (openssl rand -hex 32) is the common mistake: it decodes
#     to 48 bytes and will fail boot. Use -base64.
#
# CI upserts this into the VM .env from the GH secret LIVE_ENCRYPTION_SECRET on
# every deploy. Rotating it orphans ciphertext written under the old key — those
# devices show zero windows until their next push, which is at most one push cycle
# (~2 min) away: even a device whose tabs never change re-writes the field on its
# next no-op push (writeSnapshot opportunistically migrates plaintext/stale rows).
LIVE_ENCRYPTION_SECRET=

# Retention / abuse bounds (defaults shown).
LIVE_TTL_DAYS=7
LIVE_PUSH_QUOTA_PER_DAY=2000

# ── SSE fan-out tuning (defaults shown) ─────────────────────────────────────
# Trailing window that batches pub/sub-triggered frames per user into one
# read + serialize + broadcast to all that user's viewers. Higher = fewer frames
# under bursty pushes, at up to this many ms of extra latency. 0 = send each
# event immediately (no coalescing).
LIVE_FANOUT_COALESCE_MS=500
# While ≥1 viewer is connected, re-emit a fresh state frame this often so idle
# devices' "last seen" age stays current (heartbeats no longer fan out). Skipped
# when a frame already went out within the window; zero cost with no viewers.
LIVE_REFRESH_EMIT_MS=60000

# Dev-only tokenless bypass (ignored in production). Uses the "local" namespace.
# DEV_OPEN_API=1
NODE_ENV=production
