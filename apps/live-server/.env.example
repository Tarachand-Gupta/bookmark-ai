# @bookmark-ai/live-server — copy to .env (gitignored) and fill in.

# Port the server listens on inside the container (Caddy fronts it).
PORT=8080

# Redis connection. In compose this is the service name; locally, your own Redis.
REDIS_URL=redis://redis:6379

# ── Clerk (offline JWT verification) ────────────────────────────────────────
# EITHER the secret key (fetches JWKS once, then networkless)…
CLERK_SECRET_KEY=sk_live_xxx
# …OR, for a fully egress-free VM, a pinned PEM public key + issuer (leave the
# secret unset if you use these):
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# CLERK_ISSUER=https://clerk.bookmark-ai.cloud

# Same allowlist the web app uses (Tara's id). CSV. Empty = allow any signed-in user.
CLERK_ALLOWED_USER_IDS=user_3GIhPt5Na3tYRP3XaPPU3PpI55e

# Mirror of apps/web/lib/authorized-parties.ts — the token `azp` allowlist. CSV.
# Absent azp (native mobile) always passes; a wrong azp is rejected.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000,https://bookmark-ai.cloud,https://www.bookmark-ai.cloud,https://bookmark-ai-theta.vercel.app,chrome-extension://ffhbgpgebpmofjkehpjcemepbgcmoelp

# CORS allowlist (browser origins that may call this server). CSV. Empty = reflect
# any origin — DEV ONLY; in production (NODE_ENV=production) this MUST be set or
# the server fails to start (it refuses to reflect any origin).
LIVE_ALLOWED_ORIGINS=https://bookmark-ai.cloud,https://www.bookmark-ai.cloud,http://localhost:3000,http://127.0.0.1:3000,chrome-extension://ffhbgpgebpmofjkehpjcemepbgcmoelp

# Retention / abuse bounds (defaults shown).
LIVE_TTL_DAYS=7
LIVE_PUSH_QUOTA_PER_DAY=2000

# Dev-only tokenless bypass (ignored in production). Uses the "local" namespace.
# DEV_OPEN_API=1
NODE_ENV=production
