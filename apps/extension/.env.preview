# Build-target defaults for `wxt build -m preview` (`pnpm build:preview`). All
# values are PUBLIC. Points at the Vercel preview deployment, which runs the dev
# Clerk instance — so both the app URL and the Clerk syncHost are the preview
# origin. (If the preview ever moves to the production Clerk instance, swap the
# publishable key to pk_live and the syncHost stays the preview origin.)
WXT_APP_URL=https://bookmark-ai-wine.vercel.app
WXT_LIVE_API_URL=https://live.bookmark-ai.cloud
WXT_CLERK_PUBLISHABLE_KEY=pk_test_ZGFybGluZy1iYWJvb24tMTMuY2xlcmsuYWNjb3VudHMuZGV2JA
WXT_CLERK_SYNC_HOST=https://bookmark-ai-wine.vercel.app
