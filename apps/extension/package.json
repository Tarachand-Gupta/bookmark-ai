{
  "name": "@bookmark-ai/extension",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "node ../../scripts/supabase-production.mjs chrome build",
    "build:local": "node ./scripts/wxt-run.mjs build -m development",
    "build:dev": "node ./scripts/wxt-run.mjs build -m dev-remote",
    "build:firefox": "node ../../scripts/supabase-production.mjs firefox build",
    "build:firefox:local": "node ./scripts/wxt-run.mjs build -b firefox -m development",
    "build:safari": "node ../../scripts/supabase-production.mjs safari build",
    "build:safari:local": "node ./scripts/wxt-run.mjs build -b safari --mv3 -m development",
    "zip": "node ../../scripts/supabase-production.mjs chrome zip",
    "zip:firefox": "node ../../scripts/supabase-production.mjs firefox zip",
    "zip:safari": "node ../../scripts/supabase-production.mjs safari zip",
    "zip:store": "node ../../scripts/extension-production-sources.mjs",
    "release:zip": "node ../../scripts/supabase-production.mjs chrome zip && node ../../scripts/supabase-production.mjs firefox zip && node ../../scripts/extension-production-sources.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "icons:safari-app": "node scripts/generate-safari-app-icon.mjs",
    "safari:xcode": "bash scripts/safari-xcode.sh",
    "safari:version": "node scripts/safari-version.mjs --check",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "node ./scripts/wxt-run.mjs prepare"
  },
  "dependencies": {
    "@bookmark-ai/types": "workspace:*",
    "@clerk/chrome-extension": "^3.1.55",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "wxt": "^0.20.27"
  }
}
