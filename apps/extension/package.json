{
  "name": "@bookmark-ai/extension",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "node ./scripts/wxt-run.mjs build",
    "build:local": "node ./scripts/wxt-run.mjs build -m development",
    "build:dev": "node ./scripts/wxt-run.mjs build -m dev-remote",
    "build:firefox": "node ./scripts/wxt-run.mjs build -b firefox",
    "build:firefox:local": "node ./scripts/wxt-run.mjs build -b firefox -m development",
    "build:safari": "node ./scripts/wxt-run.mjs build -b safari --mv3",
    "build:safari:local": "node ./scripts/wxt-run.mjs build -b safari --mv3 -m development",
    "zip": "node ./scripts/wxt-run.mjs zip",
    "zip:firefox": "node ./scripts/wxt-run.mjs zip -b firefox",
    "zip:safari": "node ./scripts/wxt-run.mjs zip -b safari --mv3",
    "zip:store": "node ./scripts/store-zip.mjs",
    "release:zip": "node ./scripts/wxt-run.mjs zip && node ./scripts/wxt-run.mjs zip -b firefox && node ./scripts/store-zip.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "icons:safari-app": "node scripts/generate-safari-app-icon.mjs",
    "safari:xcode": "bash scripts/safari-xcode.sh",
    "safari:version": "node scripts/safari-version.mjs --check",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "node ./scripts/wxt-run.mjs prepare"
  },
  "dependencies": {
    "@bookmark-ai/types": "workspace:*",
    "@clerk/chrome-extension": "^3.1.55",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "wxt": "^0.20.27"
  }
}
