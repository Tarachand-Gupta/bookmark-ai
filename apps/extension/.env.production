# Build-target defaults for `wxt build` (production). All values are PUBLIC
# (publishable keys + URLs); the secret key never ships in an extension.
# Committed so a fresh clone's `pnpm build` targets production with no setup.
# NOTE: production currently runs the DEV Clerk instance (darling-baboon-13) —
# no production Clerk instance exists yet. When one is created, swap this to
# its real pk_live key (and keep the syncHost as the production origin).
WXT_APP_URL=https://bookmark-ai.cloud
WXT_LIVE_API_URL=https://live.bookmark-ai.cloud
WXT_CLERK_PUBLISHABLE_KEY=pk_test_ZGFybGluZy1iYWJvb24tMTMuY2xlcmsuYWNjb3VudHMuZGV2JA
WXT_CLERK_SYNC_HOST=https://bookmark-ai.cloud
