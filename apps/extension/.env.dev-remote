# Build-target defaults for `wxt build -m dev-remote` (`pnpm build:dev`) — the
# DEV target (GREEN icon, "Bookmark AI (Dev)"). All values are PUBLIC. Points at
# the dedicated dev deployment https://bookmark-ai-dev.vercel.app, which runs the
# dev Clerk instance — so both the app URL and the Clerk syncHost are that dev
# origin. Mode name is `dev-remote` (NOT `development`) so it can't be confused
# with the local `wxt dev` target. A local `.env` (gitignored) still overrides.
WXT_APP_URL=https://bookmark-ai-dev.vercel.app
# Local live server (`pnpm dev:live`), NOT live.bookmark-ai.cloud: pointing the
# DEV build at prod meant green-icon test runs wrote real tab snapshots into
# prod Redis (live-server-v3.md finding). There is no remote dev live host yet;
# when one exists, point this there instead.
WXT_LIVE_API_URL=http://localhost:8091
WXT_CLERK_PUBLISHABLE_KEY=pk_test_ZGFybGluZy1iYWJvb24tMTMuY2xlcmsuYWNjb3VudHMuZGV2JA
WXT_CLERK_SYNC_HOST=https://bookmark-ai-dev.vercel.app
