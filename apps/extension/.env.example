# Build-target config is committed per mode — you normally DON'T need this file:
#   .env.development  → `pnpm dev`           (localhost:3000 + dev Clerk)
#   .env.production   → `pnpm build`         (bookmark-ai.cloud + prod Clerk)
#   .env.preview      → `pnpm build:preview` (Vercel preview + dev Clerk)
#
# Copy this file to apps/extension/.env only to OVERRIDE those defaults locally
# (e.g. point dev at a different server or Clerk instance). A plain `.env` is
# gitignored and loaded in every mode with higher precedence than the per-mode
# files above. All values are PUBLIC (the secret key never ships in an extension).

# App origin — web UI + its /api/* routes (same deployment serves both). Drives
# the API base, the "Open website"/sign-in links, everything.
WXT_APP_URL=http://localhost:3000

# Live Sessions server (Fastify, separate from /api/*).
WXT_LIVE_API_URL=http://localhost:8091

# Clerk publishable key — dev instance (matches apps/web's dev keys).
WXT_CLERK_PUBLISHABLE_KEY=pk_test_ZGFybGluZy1iYWJvb24tMTMuY2xlcmsuYWNjb3VudHMuZGV2JA

# Origin whose Clerk session the extension mirrors — where you sign in to the
# web app. Cookies are not port-scoped, so localhost covers the dev app on :3000.
WXT_CLERK_SYNC_HOST=http://localhost
