# All values here are PUBLIC (the secret key never ships in an extension).
# Working defaults are baked into lib/clerk.ts — set these only to override.

# Clerk publishable key (same instance as apps/web).
WXT_CLERK_PUBLISHABLE_KEY=pk_test_ZGFybGluZy1iYWJvb24tMTMuY2xlcmsuYWNjb3VudHMuZGV2JA

# Origin whose Clerk session the extension mirrors — where you sign in to the
# web app. Cookies are not port-scoped, so localhost covers the dev app on
# :3000. Point at the deployed web origin to sync with production instead.
WXT_CLERK_SYNC_HOST=http://localhost
