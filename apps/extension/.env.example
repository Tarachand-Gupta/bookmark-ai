# All values here are PUBLIC (the secret key never ships in an extension).
# The baked-in defaults in lib/clerk.ts target the PRODUCTION Clerk instance
# (clerk.bookmark-ai.cloud + https://bookmark-ai.cloud syncHost). Copy this file
# to apps/extension/.env to override them for LOCAL DEVELOPMENT — i.e. sign in
# against the dev instance on the local web app instead.

# Clerk publishable key — dev instance (matches apps/web's dev keys).
WXT_CLERK_PUBLISHABLE_KEY=pk_test_ZGFybGluZy1iYWJvb24tMTMuY2xlcmsuYWNjb3VudHMuZGV2JA

# Origin whose Clerk session the extension mirrors — where you sign in to the
# web app. Cookies are not port-scoped, so localhost covers the dev app on
# :3000. (The production default is https://bookmark-ai.cloud.)
WXT_CLERK_SYNC_HOST=http://localhost
