# Build-target defaults for `wxt` (dev, `pnpm dev`) AND `wxt build -m development`
# (`pnpm build:local`) — the LOCAL target (RED icon, "Bookmark AI (Local)"). All
# values are PUBLIC. Points at the local web dev server (:3000, which serves the
# same /api) and the dev Clerk instance. Clerk syncHost is host-only (cookies are
# not port-scoped, so http://localhost covers :3000). A local `.env` (gitignored)
# still overrides these if you need to point somewhere else.
WXT_APP_URL=http://localhost:3000
WXT_LIVE_API_URL=http://localhost:8091
WXT_CLERK_PUBLISHABLE_KEY=pk_test_ZGFybGluZy1iYWJvb24tMTMuY2xlcmsuYWNjb3VudHMuZGV2JA
WXT_CLERK_SYNC_HOST=http://localhost
