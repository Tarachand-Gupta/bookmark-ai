# Isolated development only. Copy to .env.supabase.local; never commit secrets.
BOOKMARK_BUILD_VARIANT=supabase-qa
AUTH_PROVIDER=supabase
NEXT_PUBLIC_AUTH_PROVIDER=supabase
SUPABASE_URL=https://xogqaqtyacmecdbmgqqd.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xogqaqtyacmecdbmgqqd.supabase.co
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Restricted runtime login through the transaction pooler, not the postgres login.
SUPABASE_DATABASE_URL=
# Base64-encoded official Supabase root CA; certificate verification remains enabled.
SUPABASE_DATABASE_CA_BASE64=
MASTER_CREDENTIAL_ENCRYPTION_KEY=
AI_KEY_ENCRYPTION_SECRET=
DEVICE_TOKEN_SECRET=
CRON_SECRET=
MULTI_TENANT=1
TENANT_PLATFORM=turso
TENANT_DB_PREFIX=bmai-sbqa-
TURSO_ORG=
TURSO_GROUP=bmai-supabase-qa
# Group-scoped: read, db:create, db:delete, db:mint-token only.
TURSO_API_TOKEN=
BOOKMARK_QA_WEB_URL=http://localhost:3100
BOOKMARK_QA_LIVE_URL=http://localhost:3101
# Separate local instance, only for Live Tabs content; never auth token records.
REDIS_URL=redis://127.0.0.1:6386/0
# Generate a new base64-encoded 32-byte key for this QA instance.
LIVE_ENCRYPTION_SECRET=
SUPABASE_EXTENSION_CHROME_CLIENT_ID=
SUPABASE_EXTENSION_FIREFOX_CLIENT_ID=
SUPABASE_EXTENSION_SAFARI_CLIENT_ID=
SUPABASE_EXTENSION_CLIENT_IDS=
SUPABASE_EXTENSION_CLIENT_TYPES={}
SUPABASE_EXTENSION_REDIRECT_URIS=
POSTHOG_ENABLED=false
LANGFUSE_TRACING_ENVIRONMENT=supabase-qa
NEW_RELIC_LOG_ENABLED=false
